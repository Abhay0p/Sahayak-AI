# Sahayak AI - Environment Variables Example
# DO NOT put real secrets or credentials in this file.
# Copy this file to `.env.local` (frontend) and `.env` (backend) to configure your local setup.

# ==========================================
# BACKEND & DATABASE CONFIGURATION
# ==========================================

# Prisma Database URL (SQLite used for local development)
DATABASE_URL="file:./dev.db"

# JWT Secret for Authentication (Must be exactly the same in frontend and backend)
JWT_SECRET="your-256-bit-secret-key-here"

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# Application Meta
NEXT_PUBLIC_APP_NAME="Sahayak AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend Service URLs
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:8005"

# ==========================================
# AI & VOICE SERVICES
# ==========================================

# Google Gemini API Key (Required for AI interactions, Routine parsing, Voice Chat)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY="your-google-gemini-api-key"
AI_API_KEY="your-google-gemini-api-key"

# ==========================================
# SUPABASE CONFIGURATION (Optional / If enabled)
# ==========================================

# Supabase URL and Keys (Required if using Supabase Auth or Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
